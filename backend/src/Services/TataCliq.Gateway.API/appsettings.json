{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "tatacliq-auth",
    "Audience": "tatacliq-client"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/v1/users/{**catch-all}" }
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/v1/catalog/{**catch-all}" }
      },
      "products-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/v1/products/{**catch-all}" }
      },
      "categories-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/v1/categories/{**catch-all}" }
      },
      "brands-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/v1/brands/{**catch-all}" }
      },
      "attributes-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/v1/attributes/{**catch-all}" }
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": { "Path": "/api/v1/cart/{**catch-all}" }
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": { "Path": "/api/v1/orders/{**catch-all}" }
      },
      "admin-route": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/api/v1/admin/{**catch-all}" }
      },
      "seller-route": {
        "ClusterId": "seller-cluster",
        "Match": { "Path": "/api/v1/seller/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": { "Address": "http://localhost:5001/" }
        }
      },
      "user-cluster": {
        "Destinations": {
          "user": { "Address": "http://localhost:5002/" }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog": { "Address": "http://localhost:5003/" }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "cart": { "Address": "http://localhost:5004/" }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order": { "Address": "http://localhost:5005/" }
        }
      },
      "admin-cluster": {
        "Destinations": {
          "admin": { "Address": "http://localhost:5009/" }
        }
      },
      "seller-cluster": {
        "Destinations": {
          "seller": { "Address": "http://localhost:5010/" }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
