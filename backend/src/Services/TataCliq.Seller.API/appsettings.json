{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver,1433;Database=TataCliqDb;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "tatacliq-auth",
    "Audience": "tatacliq-client"
  },
  "RazorpayPayout": {
    "KeyId":          "REPLACE_WITH_RZP_KEY_ID",
    "KeySecret":      "REPLACE_WITH_RZP_KEY_SECRET",
    "AccountNumber":  "REPLACE_WITH_RZP_ACCOUNT_NUMBER",
    "Currency":       "INR",
    "Mode":           "IMPS"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
